# Copy this file to .env and fill in ONE provider. .env is gitignored: never commit a key.
# A model is used by milestones 3 and 4 and by the agent milestones d1 to d5 and d8 (one check
# each, two in milestone 4). Milestones 1, 2 and 5, d6 and d7 need none of this.
# `uv run heist llm` checks the setup; `uv run heist check <id> --no-llm` skips the model checks.

# Where the project's LLM calls go: anthropic, openai, fireworks or openrouter.
HEIST_LLM_PROVIDER=anthropic

# The model, written exactly as your provider's model list writes it.
# Optional for anthropic (default: claude-opus-5-5); required for openai, fireworks and openrouter.
# Fireworks ids look like accounts/fireworks/models/<model>; OpenRouter ids like <vendor>/<model>.
# The agent milestones need a model that calls tools. Each agent check runs whole investigations,
# dozens of model calls per check: a smaller model (for Claude, a Sonnet or Haiku model instead of
# the default Opus) costs much less. `check` prints what each run used.
HEIST_LLM_MODEL=

# Claude only, optional: how much the model thinks before answering (low, medium, high, xhigh, max).
HEIST_LLM_EFFORT=

# One-shot answers are cached in .heist-cache/llm, so the same prompt is free the second time.
# Set to 0 to always call the provider. (Agent conversations are never cached.)
# HEIST_LLM_CACHE=0

# The key of the provider you picked. Leave the others commented out.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# FIREWORKS_API_KEY=
# OPENROUTER_API_KEY=

# Neo4j, for milestone 4 only (`docker compose up -d` starts it with this password). Neo4j keeps
# the password it first started with: change it here before that first start, not after.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=heist-password
